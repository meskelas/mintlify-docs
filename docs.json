{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Mint Starter Kit",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "icon": "ghost",
          "color": {
            "light": "#ffffff",
            "dark": "#ffffff"
          },
          "href": "https://haunt.site"
        },
        {
          "anchor": "Discord",
          "icon": "server",
          "color": {
            "light": "#ffffff",
            "dark": "#ffffff"
          },
          "href": "https://haunt.site/discord"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Staff Handbook",
        "icon": "user-shield",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Important",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Staffing",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "Miscellaneous ",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code"
            ]
          },
          {
            "group": "Commands",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
